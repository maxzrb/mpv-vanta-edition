<UserControl x:Class="Vanta.Installer.Views.DoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="安装完成" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
            <TextBlock Text="MPV Vanta Edition 已就绪。" FontSize="14" Margin="0,8,0,0"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 结果图标 + 摘要 -->
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="24"
                                    Background="#FFE8E0FB" VerticalAlignment="Center">
                                <TextBlock Text="✓" FontSize="26" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#FF6B3FD8" />
                            </Border>
                            <TextBlock Text="{Binding Summary, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Margin="0,20,0,0">
                            <TextBlock FontSize="13"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}">
                                <Run Text="安装目录：" /><Run Text="{Binding InstallDirectory}" />
                            </TextBlock>
                            <TextBlock Margin="0,8,0,0" FontSize="13"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}"
                                       Text="{Binding MpvVersion}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,8,0,0" FontSize="13"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}">
                                <Run Text="升级前配置备份：" /><Run Text="{Binding BackupPath}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- 操作按钮 -->
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Content="启动 mpv" Appearance="Primary"
                                       Padding="18,8" Command="{Binding LaunchMpvCommand}"
                                       IsEnabled="{Binding CanLaunch, Mode=OneWay}" />
                            <ui:Button Grid.Column="1" Content="打开安装目录" Appearance="Secondary"
                                       Padding="18,8" Margin="12,0,0,0"
                                       Command="{Binding OpenDirectoryCommand}" />
                        </Grid>

                        <!-- 当前用户文件关联（可选，无需管理员权限） -->
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="文件关联（可选）" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}">
                                注册后可用 mpv 打开视频/音频文件，并在“打开方式”中看到 mpv。
                                此操作写入系统注册表，需要管理员权限，将弹出 UAC 确认。
                            </TextBlock>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="注册文件关联" Appearance="Primary"
                                           Padding="18,8" Command="{Binding RegisterAssociationsCommand}"
                                           IsEnabled="{Binding CanRegister}" />
                                <ui:Button Grid.Column="1" Content="取消文件关联" Appearance="Secondary"
                                           Padding="18,8" Margin="12,0,0,0"
                                           Command="{Binding UnregisterAssociationsCommand}"
                                           IsEnabled="{Binding CanRegister}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
