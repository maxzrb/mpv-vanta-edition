<UserControl x:Class="Vanta.Installer.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="正在安装" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
            <TextBlock Text="点击底部“开始安装”执行；安装过程中请勿关闭窗口。" FontSize="14" Margin="0,8,0,0"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- 进度条 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Percent}"
                                         Height="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding PercentText, Mode=OneWay}" Margin="16,0,0,0"
                                       VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                        </Grid>

                        <TextBlock Margin="0,16,0,0" Text="{Binding CurrentMessage}" FontSize="14"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding CurrentFile}" FontSize="12"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- 结果 InfoBar -->
                        <ui:InfoBar IsOpen="{Binding IsCompleted, Mode=OneWay}" Margin="0,16,0,0">
                            <ui:InfoBar.Style>
                                <Style TargetType="ui:InfoBar">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccess, Mode=OneWay}" Value="True">
                                            <Setter Property="Severity" Value="Success" />
                                            <Setter Property="Title" Value="安装完成" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSuccess, Mode=OneWay}" Value="False">
                                            <Setter Property="Severity" Value="Error" />
                                            <Setter Property="Title" Value="安装未完成" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:InfoBar.Style>
                        </ui:InfoBar>
                    </StackPanel>
                </ui:Card>

                <!-- 日志 -->
                <ui:Card Padding="24">
                    <StackPanel>
                        <TextBlock Text="安装日志" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                        <!-- 命令行风格日志：黑色背景 + 等宽字体 + 自动滚动 -->
                        <TextBox x:Name="LogBox" Margin="0,12,0,0" Height="200"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 Background="#FF101014" Foreground="#FFE6E6F0"
                                 BorderBrush="#FF2A2A38" BorderThickness="1"
                                 IsReadOnly="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Padding="10,8"
                                 TextChanged="LogBox_TextChanged" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
