<UserControl x:Class="Vanta.Installer.Views.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- 卡片描述（12 灰） -->
        <Style x:Key="CardDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="选择要安装的组件" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
            <TextBlock Text="03（AI 字幕）与 04（补帧）为可选扩展，可按需取消。" FontSize="14" Margin="0,8,0,0"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding SummaryText}" FontSize="12" Margin="4,0,0,12"
                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />

                <ui:Card Padding="24">
                    <ItemsControl ItemsSource="{Binding Packages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="16,12" CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Wpf.Ui.Brushes.DividerStrokeColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding IsEnabled}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Id, Mode=OneWay}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                                <Border Background="#FFE8E0FB" CornerRadius="4" Padding="6,1" Margin="10,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRequired, Mode=OneWay}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="必选" FontSize="11" Foreground="#FF6B3FD8" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,6,0,0" FontSize="12"
                                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StatusText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="v" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorTertiaryBrush}">
                                            <Run Text="{Binding Version, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:Card>

                <!-- 文件关联注册 -->
                <ui:Card Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="文件关联注册" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource CardDescStyle}">
                            安装完成后把播放器注册为文件打开方式（写注册表，需 UAC）。可同时勾选两种入口，之后在 Windows「打开方式」里自行选择用哪个打开视频。
                        </TextBlock>
                        <StackPanel Margin="0,14,0,0">
                            <CheckBox Content="注册多实例关联（双击经 mpv.exe 新开窗口）"
                                      IsChecked="{Binding RegisterMultiInstance}" Margin="0,0,0,10" />
                            <CheckBox Content="注册单实例关联（双击经 umpv.exe 复用同一窗口）"
                                      IsChecked="{Binding RegisterSingleInstance}" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorTertiaryBrush}">
                            不勾选也能正常安装，之后可在「设置 → 文件关联」随时注册或取消。
                        </TextBlock>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
