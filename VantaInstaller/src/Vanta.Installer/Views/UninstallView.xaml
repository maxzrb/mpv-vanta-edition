<UserControl x:Class="Vanta.Installer.Views.UninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="卸载 MPV Vanta Edition" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
            <TextBlock Text="卸载前默认备份配置，删除操作不可撤销，请确认目标目录。" FontSize="14" Margin="0,8,0,0"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 阶段1：检测与选项（未执行） -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility"
                                    Value="{Binding ShowOptions, Converter={StaticResource BoolToVis}}" />
                        </Style>
                    </StackPanel.Style>
                    <ui:Card Padding="24" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="检测结果" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding UninstallDirectory, Mode=OneWay}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                <ui:Button Grid.Column="1" Content="清除指定" Appearance="Secondary"
                                           Margin="10,0,0,0" Padding="14,6"
                                           Command="{Binding ClearManualPathCommand}"
                                           Visibility="{Binding HasManualPath, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Grid.Column="2" Content="浏览…" Appearance="Secondary"
                                           Margin="10,0,0,0" Padding="14,6"
                                           Command="{Binding ChooseDirectoryCommand}" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorTertiaryBrush}"
                                       Visibility="{Binding HasManualPath, Converter={StaticResource BoolToVis}}">
                                <Run Text="手动指定位置：" /><Run Text="{Binding ManualMpvPath, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,10,0,0" Text="{Binding VersionLine, Mode=OneWay}" FontSize="12"
                                       FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
                            <TextBlock Margin="0,8,0,0" FontSize="12"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}">
                                <Run Text="占用空间：" /><Run Text="{Binding SizeText, Mode=OneWay}" />
                            </TextBlock>

                            <ui:InfoBar IsOpen="{Binding IsDetected}" Margin="0,16,0,0">
                                <ui:InfoBar.Style>
                                    <Style TargetType="ui:InfoBar" BasedOn="{StaticResource {x:Type ui:InfoBar}}">
                                        <Setter Property="Severity" Value="Warning" />
                                        <Setter Property="Title" Value="检测到 mpv（非 Vanta 安装）" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVanta}" Value="True">
                                                <Setter Property="Severity" Value="Success" />
                                                <Setter Property="Title" Value="检测到 Vanta 安装" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:InfoBar.Style>
                            </ui:InfoBar>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="24" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="卸载选项" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                            <CheckBox Content="备份 portable_config 配置（推荐）"
                                      IsChecked="{Binding BackupConfig}" Margin="0,14,0,0" />
                            <CheckBox Content="同时清理当前用户的文件关联（无需管理员权限）"
                                      IsChecked="{Binding CleanupAssociations}" Margin="0,10,0,0" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- 阶段2：执行中 -->
                <ui:Card Padding="24" Margin="0,0,0,16"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="正在卸载…" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,12,0,0" Text="{Binding CurrentMessage, Mode=OneWay}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:Card>

                <!-- 阶段3：完成 -->
                <StackPanel Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                    <ui:Card Padding="24" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentMessage, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}">
                                <Run Text="配置备份：" /><Run Text="{Binding BackupPath, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}">
                                <Run Text="释放空间：" /><Run Text="{Binding FreedText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </ui:Card>

                </StackPanel>

                <!-- 卸载日志（阶段2执行中 / 阶段3完成均显示） -->
                <ui:Card Padding="24" Visibility="{Binding HasLog, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="卸载日志" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                        <!-- 命令行风格日志：黑色背景 + 等宽字体 + 自动滚动 -->
                        <TextBox x:Name="UninstallLogBox" Margin="0,12,0,0" Height="160"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 Background="#FF101014" Foreground="#FFE6E6F0"
                                 BorderBrush="#FF2A2A38" BorderThickness="1"
                                 IsReadOnly="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Padding="10,8"
                                 TextChanged="UninstallLogBox_TextChanged" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
