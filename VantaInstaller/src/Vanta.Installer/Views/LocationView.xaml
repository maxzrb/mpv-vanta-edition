<UserControl x:Class="Vanta.Installer.Views.LocationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="选择安装位置" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
            <TextBlock Text="若目标目录已存在旧版 mpv，将自动进入覆盖升级模式（升级前备份配置）。" FontSize="14" Margin="0,8,0,0"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="安装目录" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="选择 MPV Vanta Edition 安装目录…" />
                            <ui:Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0" Padding="16,7"
                                       Appearance="Secondary" Command="{Binding ChooseDirectoryCommand}" />
                        </Grid>

                        <!-- 状态：覆盖升级 / 全新安装 / 空间不足 -->
                        <ui:InfoBar IsOpen="True" Title="{Binding StatusText}" Margin="0,16,0,0">
                            <ui:InfoBar.Style>
                                <Style TargetType="ui:InfoBar">
                                    <Setter Property="Severity" Value="Success" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                            <Setter Property="Severity" Value="Error" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUpgrade}" Value="True">
                                            <Setter Property="Severity" Value="Informational" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:InfoBar.Style>
                        </ui:InfoBar>
                    </StackPanel>
                </ui:Card>

                <ui:Card Padding="24">
                    <StackPanel>
                        <TextBlock Text="覆盖升级说明" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}">
                            <Run Text="• 升级前自动备份 portable_config 到 backup\ 目录，保留最近 5 份。" /><LineBreak />
                            <Run Text="• 按 01→02→03→04→05 顺序覆盖，同名文件以新版本为准。" /><LineBreak />
                            <Run Text="• 全程免管理员权限（便携版不写注册表）。" />
                        </TextBlock>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
