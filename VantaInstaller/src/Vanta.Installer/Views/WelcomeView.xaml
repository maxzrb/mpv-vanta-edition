<UserControl x:Class="Vanta.Installer.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="欢迎使用 Vanta Installer" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
            <TextBlock Text="选择包含 01~05 增量包的文件夹，安装器会自动校验完整性与版本一致性。" FontSize="14" Margin="0,8,0,0"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 包目录选择 -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="包目录" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="包含 01~05 增量包的文件夹…" />
                            <ui:Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0" Padding="16,7"
                                       Appearance="Secondary" Command="{Binding ChooseDirectoryCommand}" />
                            <ui:Button Grid.Column="2" Content="重新扫描" Margin="10,0,0,0" Padding="16,7"
                                       Appearance="Primary" Command="{Binding ScanAsyncCommand}" />
                        </Grid>
                        <TextBlock Margin="0,12,0,0" FontSize="12"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorTertiaryBrush}">
                            提示：发布时可把安装器与 01~05 包放在同一文件夹，启动即自动识别。
                        </TextBlock>
                    </StackPanel>
                </ui:Card>

                <!-- 扫描状态 -->
                <ui:InfoBar IsOpen="True" Title="{Binding StatusText}" Severity="Informational"
                            Margin="0,0,0,16">
                    <ui:InfoBar.Style>
                        <Style TargetType="ui:InfoBar">
                            <Setter Property="Severity" Value="Success" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                    <Setter Property="Severity" Value="Error" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                    <Setter Property="Severity" Value="Warning" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Severity" Value="Informational" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:InfoBar.Style>
                </ui:InfoBar>

                <!-- 扫描结果摘要 -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="识别到的包" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                        <ItemsControl ItemsSource="{Binding ScanResult.Packages}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorTertiaryBrush}">
                                            <Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <!-- 错误/警告明细 -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <ui:Card.Style>
                        <Style TargetType="ui:Card">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Card.Style>
                    <StackPanel>
                        <TextBlock Text="问题明细" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                        <ItemsControl ItemsSource="{Binding ScanResult.Errors}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,3" Foreground="#FFC42B1C" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
