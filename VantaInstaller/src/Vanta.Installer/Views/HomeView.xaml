<UserControl x:Class="Vanta.Installer.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Vanta 工具台" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
            <TextBlock Text="安装、卸载与日常维护 MPV Vanta Edition。" FontSize="14" Margin="0,8,0,0"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 当前状态 -->
                <ui:InfoBar IsOpen="True" Margin="0,0,0,20"
                            Title="{Binding StatusTitle, Mode=OneWay}"
                            Message="{Binding StatusSubtitle, Mode=OneWay}">
                    <ui:InfoBar.Style>
                        <Style TargetType="ui:InfoBar" BasedOn="{StaticResource {x:Type ui:InfoBar}}">
                            <Setter Property="Severity" Value="Informational" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsInstalled}" Value="True" />
                                        <Condition Binding="{Binding IsVanta}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Severity" Value="Success" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsInstalled}" Value="True" />
                                        <Condition Binding="{Binding IsVanta}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Severity" Value="Warning" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:InfoBar.Style>
                </ui:InfoBar>

                <!-- 已安装时显示版本 -->
                <ui:Card Padding="24" Margin="0,0,0,20"
                         Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="当前安装" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding InstallDirectory, Mode=OneWay}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding VersionLine, Mode=OneWay}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <!-- 手动指定位置时提示，可一键清除恢复自动检测 -->
                        <Grid Margin="0,12,0,0"
                              Visibility="{Binding HasManualPath, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorTertiaryBrush}">
                                <Run Text="手动指定：" /><Run Text="{Binding ManualMpvPath, Mode=OneWay}" />
                            </TextBlock>
                            <ui:Button Grid.Column="1" Content="清除指定" Appearance="Secondary" Padding="10,4"
                                       Margin="12,0,0,0" Command="{Binding ClearManualPathCommand}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 指定已安装的 mpv 位置（仅未检测到安装时显示，作为补救入口） -->
                <ui:Card Padding="24" Margin="0,0,0,20"
                         Visibility="{Binding IsInstalled, Converter={StaticResource InverseVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="指定已安装的 mpv 位置" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}">
                                    手动指定一个已安装的 mpv 目录（Vanta 或任意 mpv），工具台将优先识别该位置；适用于未自动检测到的安装。
                                </TextBlock>
                                <!-- 当前手动指定路径 -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                            Visibility="{Binding HasManualPath, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="当前指定：" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding ManualMpvPath, Mode=OneWay}" FontSize="12"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <ui:Button Content="清除指定" Appearance="Secondary" Padding="14,7" Margin="0,0,8,0"
                                           Command="{Binding ClearManualPathCommand}"
                                           Visibility="{Binding HasManualPath, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Content="浏览…" Appearance="Secondary" Padding="14,7"
                                           Command="{Binding ChooseManualPathCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 三大模式卡片 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 安装 -->
                    <ui:Button Grid.Column="0" Command="{Binding StartInstallCommand}"
                               HorizontalAlignment="Stretch"
                               AutomationProperties.Name="安装"
                               Padding="0" Margin="0"
                               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ui:Button.Template>
                            <ControlTemplate TargetType="ui:Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource Wpf.Ui.Brushes.DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="20,24" HorizontalAlignment="Stretch"
                                        MinHeight="190">
                                    <StackPanel>
                                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="34" Foreground="#FF8A6BF8" />
                                        <TextBlock Text="安装" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" TextAlignment="Center"
                                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="将 01~05 增量包安装到指定位置，支持覆盖升级"
                                                   FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                                   MinHeight="36"
                                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </ui:Button.Template>
                    </ui:Button>

                    <!-- 卸载 -->
                    <ui:Button Grid.Column="2" Command="{Binding StartUninstallCommand}"
                               HorizontalAlignment="Stretch"
                               AutomationProperties.Name="卸载"
                               Padding="0" Margin="0"
                               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ui:Button.Template>
                            <ControlTemplate TargetType="ui:Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource Wpf.Ui.Brushes.DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="20,24" HorizontalAlignment="Stretch"
                                        MinHeight="190">
                                    <StackPanel HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="34" Foreground="#FFD13438" />
                                        <TextBlock Text="卸载" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" TextAlignment="Center"
                                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="备份配置后卸载，可选清理文件关联"
                                                   FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                                   MinHeight="36"
                                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </ui:Button.Template>
                    </ui:Button>

                    <!-- 设置 -->
                    <ui:Button Grid.Column="4" Command="{Binding OpenSettingsCommand}"
                               HorizontalAlignment="Stretch"
                               AutomationProperties.Name="设置"
                               Padding="0" Margin="0"
                               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ui:Button.Template>
                            <ControlTemplate TargetType="ui:Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource Wpf.Ui.Brushes.DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="20,24" HorizontalAlignment="Stretch"
                                        MinHeight="190">
                                    <StackPanel HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Settings24" FontSize="34" Foreground="#FF0078D4" />
                                        <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" TextAlignment="Center"
                                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="启动、信息、配置备份与检查更新"
                                                   FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                                   MinHeight="36"
                                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </ui:Button.Template>
                    </ui:Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
