<UserControl x:Class="Vanta.Installer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- mpv 配置项控件模板（按类型切换，控件统一宽度对齐） -->
        <DataTemplate x:Key="MpvBoolTemplate">
            <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding DisplayName}" />
        </DataTemplate>
        <DataTemplate x:Key="MpvChoiceTemplate">
            <ComboBox Width="200" ItemsSource="{Binding Choices}" SelectedValuePath="Value"
                      AutomationProperties.Name="{Binding DisplayName}"
                      SelectedValue="{Binding CurrentValue, Mode=TwoWay}" VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>
        <DataTemplate x:Key="MpvSliderTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Slider Width="120" Minimum="{Binding Option.Min}" Maximum="{Binding Option.Max}"
                        Value="{Binding SliderValue, Mode=TwoWay}" />
                <TextBlock Text="{Binding CurrentValue}" Width="32" Margin="8,0,0,0"
                           VerticalAlignment="Center" FontSize="12" TextAlignment="Right"
                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MpvTextTemplate">
            <TextBox Width="200" Text="{Binding CurrentValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" />
        </DataTemplate>

        <!-- 卡片标题（16 黑） -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
        </Style>

        <!-- 卡片描述（12 灰） -->
        <Style x:Key="CardDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
            <TextBlock Text="日常维护与用户设置。" FontSize="14" Margin="0,8,0,0"
                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 状态与操作 -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <ui:InfoBar IsOpen="True" Margin="0,0,0,16"
                                    Title="{Binding StatusTitle, Mode=OneWay}"
                                    Message="{Binding StatusMessage, Mode=OneWay}">
                            <ui:InfoBar.Style>
                                <Style TargetType="ui:InfoBar" BasedOn="{StaticResource {x:Type ui:InfoBar}}">
                                    <Setter Property="Severity" Value="Informational" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVanta}" Value="True">
                                            <Setter Property="Severity" Value="Success" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:InfoBar.Style>
                        </ui:InfoBar>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Content="启动 mpv" Appearance="Primary"
                                       Command="{Binding LaunchMpvCommand}" IsEnabled="{Binding IsInstalled}"
                                       Padding="16,8" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="1" Content="打开安装目录" Appearance="Secondary"
                                       Command="{Binding OpenInstallDirCommand}" IsEnabled="{Binding IsInstalled}"
                                       Padding="16,8" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="2" Content="打开配置目录" Appearance="Secondary"
                                       Command="{Binding OpenConfigDirCommand}" IsEnabled="{Binding IsInstalled}"
                                       Padding="16,8" />
                            <ui:Button Grid.Column="3" Content="指定MPV目录" Appearance="Secondary"
                                       Command="{Binding ChooseManualPathCommand}"
                                       Padding="16,8" Margin="8,0,0,0" />
                            <ui:Button Grid.Column="4" Content="清除指定" Appearance="Secondary"
                                       Command="{Binding ClearManualPathCommand}"
                                       Visibility="{Binding ShowManualClear, Converter={StaticResource BoolToVis}}"
                                       Padding="16,8" Margin="8,0,0,0" />
                        </Grid>

                    </StackPanel>
                </ui:Card>

                <!-- 文件关联 -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="文件关联" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CardDescStyle}">
                            注册后用 mpv 打开视频/音频文件；写入注册表，需要管理员权限（弹 UAC）。
                        </TextBlock>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Content="注册文件关联" Appearance="Primary"
                                       Command="{Binding RegisterAssociationsCommand}"
                                       IsEnabled="{Binding CanRegister}" Padding="16,8" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="1" Content="取消文件关联" Appearance="Secondary"
                                       Command="{Binding UnregisterAssociationsCommand}"
                                       IsEnabled="{Binding CanRegister}" Padding="16,8" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 配置备份 / 恢复 -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="配置备份与恢复" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CardDescStyle}">
                            备份 portable_config 到 backup\ 目录；恢复前会自动备份当前配置。
                        </TextBlock>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Content="立即备份" Appearance="Primary"
                                       Command="{Binding BackupNowCommand}" IsEnabled="{Binding IsInstalled}"
                                       Padding="16,8" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="1" Content="打开备份目录" Appearance="Secondary"
                                       Command="{Binding OpenBackupDirCommand}" IsEnabled="{Binding IsInstalled}"
                                       Padding="16,8" />
                        </Grid>

                        <!-- 备份目录：可手动指定，立即备份/历史备份/恢复均跟随 -->
                        <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource Wpf.Ui.Brushes.DividerStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="备份目录" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center"
                                           Text="{Binding BackupDirectory, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorTertiaryBrush}" />
                                <ui:Button Grid.Column="2" Content="清除指定" Appearance="Secondary" Padding="12,6"
                                           Command="{Binding ClearBackupDirectoryCommand}"
                                           Visibility="{Binding ShowBackupClear, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,8,0" />
                                <ui:Button Grid.Column="3" Content="选择备份目录…" Appearance="Secondary" Padding="12,6"
                                           Command="{Binding ChooseBackupDirectoryCommand}"
                                           IsEnabled="{Binding IsInstalled}" />
                            </Grid>
                        </Border>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding HasBackups, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="历史备份" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                            <ListBox ItemsSource="{Binding Backups}" Margin="0,10,0,0" MaxHeight="180"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayText, Mode=OneWay}"
                                                       VerticalAlignment="Center" FontSize="13"
                                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
                                            <ui:Button Grid.Column="1" Content="恢复" Appearance="Secondary"
                                                       Padding="12,4" Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- 检查更新和下载增量包 -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="检查更新和下载增量包" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CardDescStyle}">
                            检查最新版本并列出可下载的 01~05 增量包；使用 aria2 多线程下载。
                        </TextBlock>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding UpdateStatus, Mode=OneWay}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Content="打开发布页" Appearance="Secondary"
                                           Command="{Binding OpenReleasePageCommand}"
                                           Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                                           Padding="14,7" Margin="0,0,10,0" />
                                <ui:Button Content="检查更新" Appearance="Primary"
                                           Command="{Binding CheckUpdateCommand}"
                                           IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBool}}"
                                           Padding="16,7" />
                            </StackPanel>
                        </Grid>

                        <!-- 下载区（检查更新后显示） -->
                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding HasDownloadItems, Converter={StaticResource BoolToVis}}">
                            <Border Margin="0,10,0,0" Padding="0,0,0,0" BorderThickness="0,1,0,0"
                                    BorderBrush="{DynamicResource Wpf.Ui.Brushes.DividerStrokeColorDefaultBrush}" />
                            <TextBlock Margin="0,14,0,0" FontSize="12"
                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}"
                                   Text="{Binding DownloadSummary, Mode=OneWay}" TextWrapping="Wrap" />

                        <!-- 镜像选择与检测 -->
                        <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource Wpf.Ui.Brushes.DividerStrokeColorDefaultBrush}"
                                Visibility="{Binding ShowMirrorOptions, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="下载镜像（单选）" VerticalAlignment="Center" FontSize="14"
                                               Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                    <ComboBox Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                                              ItemsSource="{Binding MirrorOptions}"
                                              SelectedItem="{Binding SelectedMirror, Mode=TwoWay}"
                                              AutomationProperties.Name="下载镜像">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ui:Button Grid.Column="2" Content="测试连通性" Appearance="Secondary"
                                               Command="{Binding ProbeMirrorsCommand}"
                                               IsEnabled="{Binding IsProbingMirrors, Converter={StaticResource InverseBool}}"
                                               Padding="12,6" />
                                </Grid>
                                <TextBlock Margin="0,10,0,0" Text="{Binding MirrorStatus, Mode=OneWay}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
                                <!-- 逐镜像测速结果 -->
                                <ItemsControl ItemsSource="{Binding MirrorProbeResults}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Mirror.Name}" FontSize="12"
                                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding SpeedText, Mode=OneWay}"
                                                           Margin="10,0,0,0" FontSize="12"
                                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText, Mode=OneWay}"
                                                           Margin="10,0,0,0" FontSize="11" Width="120" TextAlignment="Right"
                                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorTertiaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 下载进度（进行中/完成） -->
                        <Grid Margin="0,10,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100"
                                         Value="{Binding DownloadPercent, Mode=OneWay}" Height="10"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="13" FontWeight="SemiBold"
                                       Text="{Binding DownloadPercent, Mode=OneWay, StringFormat={}{0}%}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- 资产列表 -->
                        <ItemsControl ItemsSource="{Binding DownloadItems}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  IsEnabled="{Binding Exists, Converter={StaticResource InverseBool}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" FontSize="11" Width="90" TextAlignment="Right"
                                                   Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Content="保存到…" Appearance="Secondary"
                                       Command="{Binding ChooseDownloadDirectoryCommand}"
                                       IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"
                                       Padding="14,7" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding DownloadDirectory}" VerticalAlignment="Center"
                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorTertiaryBrush}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <ui:Button Content="开始下载" Appearance="Primary"
                                           Command="{Binding StartDownloadCommand}"
                                           IsEnabled="{Binding CanDownload}"
                                           Visibility="{Binding IsDownloading, Converter={StaticResource InverseVis}}"
                                           Padding="16,7" />
                                <ui:Button Content="停止" Appearance="Secondary"
                                           Command="{Binding StopDownloadCommand}"
                                           IsEnabled="{Binding IsDownloading}"
                                           Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                                           Padding="14,7" />
                            </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- mpv 调节 -->
                <ui:Card Padding="24" Margin="0,0,0,16"
                         Visibility="{Binding ShowMpvConfig, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="mpv 调节" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CardDescStyle}">
                            高频播放器设置，默认值与当前 mpv.conf 一致；保存前自动备份，可一键恢复。
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding MpvGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,18,0,0">
                                        <!-- 分组标题：13 黑 + 下划线分隔 -->
                                        <Border Padding="0,0,0,8" BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource Wpf.Ui.Brushes.DividerStrokeColorDefaultBrush}">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                        </Border>

                                        <!-- 选项列表：主文字 14 黑 + 描述 11 灰，行间分隔线 -->
                                        <ItemsControl ItemsSource="{Binding Options}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderThickness="0,0,0,1" Padding="0,10"
                                                            BorderBrush="{DynamicResource Wpf.Ui.Brushes.DividerStrokeColorDefaultBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="14"
                                                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                                                <TextBlock Text="{Binding Description}" Margin="0,3,0,0"
                                                                           FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                                                           Visibility="{Binding Description, Converter={StaticResource StringNotEmpty}}"
                                                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorTertiaryBrush}" />
                                                            </StackPanel>
                                                            <ContentControl Grid.Column="1" Content="{Binding}"
                                                                            VerticalAlignment="Center">
                                                                <ContentControl.Style>
                                                                    <Style TargetType="ContentControl">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource MpvBoolTemplate}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Type}" Value="Choice">
                                                                                <Setter Property="ContentTemplate" Value="{StaticResource MpvChoiceTemplate}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="Slider">
                                                                                <Setter Property="ContentTemplate" Value="{StaticResource MpvSliderTemplate}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="Text">
                                                                                <Setter Property="ContentTemplate" Value="{StaticResource MpvTextTemplate}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ContentControl.Style>
                                                            </ContentControl>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Content="保存 mpv 设置" Appearance="Primary"
                                       Command="{Binding DataContext.SaveMpvSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       IsEnabled="{Binding DataContext.MpvConfigModified, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Padding="16,8" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="1" Content="恢复初始设置" Appearance="Secondary"
                                       Command="{Binding DataContext.RestoreMpvDefaultsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Padding="16,8" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 缓存清理 -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="缓存清理" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CardDescStyle}">
                            统计并清理播放器缓存（缩略图、历史记录等，不影响配置）。
                        </TextBlock>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding CacheSizeText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorPrimaryBrush}" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding CacheDetailText, Mode=OneWay}" FontSize="11"
                                           TextWrapping="Wrap" LineHeight="17"
                                           Foreground="{DynamicResource Wpf.Ui.Brushes.TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="清理缓存" Appearance="Secondary"
                                       Command="{Binding CleanCacheCommand}" IsEnabled="{Binding IsInstalled}"
                                       Padding="16,7" VerticalAlignment="Top" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- 操作结果 -->
                <ui:InfoBar IsOpen="{Binding OperationMessage, Converter={StaticResource StringNotEmpty}}"
                            Title="{Binding OperationMessage, Mode=OneWay}"
                            Margin="0,0,0,4">
                    <ui:InfoBar.Style>
                        <Style TargetType="ui:InfoBar" BasedOn="{StaticResource {x:Type ui:InfoBar}}">
                            <Setter Property="Severity" Value="Informational" />
                        </Style>
                    </ui:InfoBar.Style>
                </ui:InfoBar>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
